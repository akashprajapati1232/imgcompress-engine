{
  "name": "@imgcompress/engine",
  "version": "1.0.0",
  "description": "Production-grade browser-side image compression engine with WASM codecs, Web Workers, and intelligent target-size optimization.",
  "license": "MIT",
  "author": "imgcompress",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "image",
    "compression",
    "browser",
    "wasm",
    "jpeg",
    "png",
    "webp",
    "avif",
    "worker",
    "optimization",
    "pica",
    "jsquash",
    "mozjpeg",
    "typescript"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run type-check && npm run test && npm run build"
  },
  "devDependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.5.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@types/node": "^26.2.0",
    "@types/pica": "^9.0.4",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^24.0.0",
    "pica": "^9.0.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashprajapati1232/image-compress-npm-package.git"
  },
  "bugs": {
    "url": "https://github.com/akashprajapati1232/image-compress-npm-package/issues"
  },
  "homepage": "https://github.com/akashprajapati1232/image-compress-npm-package#readme",
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
